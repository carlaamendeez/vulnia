# Plantilla de variables de entorno para la fase de IA (fase 2).
# Copia este archivo a .env y rellena los valores. NO subir .env al repositorio.

# Proveedor de IA de respaldo (fallback). Dejar vacio para usar solo modelo local.
AI_API_KEY=

# Modelo local via Ollama (por defecto). Ajustar segun el hardware disponible.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
